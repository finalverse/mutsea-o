[Unit]
Description=Refresh the dedicated Finalverse native TLS certificate safely
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/finalverse/native-certificate.env
ExecStart=/usr/bin/python3 /usr/local/libexec/finalverse-native-certificate --operations ${FINALVERSE_OPERATIONS}
UMask=0077
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/bg/finalverse-backend-20261015/operations
ProtectHome=read-only
