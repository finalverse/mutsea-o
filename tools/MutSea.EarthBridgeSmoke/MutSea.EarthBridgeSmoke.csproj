<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ProbeBin Condition="'$(ProbeBin)' == ''">../../bin</ProbeBin></PropertyGroup>
  <ItemGroup>
    <Reference Include="OpenMetaverse"><HintPath>$(ProbeBin)/OpenMetaverse.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>$(ProbeBin)/OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="OpenMetaverse.StructuredData"><HintPath>$(ProbeBin)/OpenMetaverse.StructuredData.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(ProbeBin)/log4net.dll</HintPath></Reference>
    <Reference Include="XMLRPC"><HintPath>$(ProbeBin)/XMLRPC.dll</HintPath></Reference>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0"/>
  </ItemGroup>
</Project>
