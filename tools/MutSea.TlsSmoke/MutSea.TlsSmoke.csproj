<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MutSeaBin Condition="'$(MutSeaBin)' == ''">../../bin</MutSeaBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MutSea.Framework.Servers.HttpServer"><HintPath>$(MutSeaBin)/MutSea.Framework.Servers.HttpServer.dll</HintPath></Reference>
    <Reference Include="MutSea.Framework"><HintPath>$(MutSeaBin)/MutSea.Framework.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(MutSeaBin)/log4net.dll</HintPath></Reference>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
</Project>
