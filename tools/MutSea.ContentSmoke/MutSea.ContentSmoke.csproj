<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <MutSeaBin Condition="'$(MutSeaBin)' == ''">../../bin</MutSeaBin>
    <!-- The Unix probe SDK is separate from the unmodified simulator SDK. -->
    <ProbeBin Condition="'$(ProbeBin)' == ''">$(MutSeaBin)</ProbeBin>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Finalverse/World/Finalverse.World.csproj" />
    <Reference Include="OpenMetaverse"><HintPath>$(ProbeBin)/OpenMetaverse.dll</HintPath></Reference>
    <Reference Include="OpenMetaverseTypes"><HintPath>$(ProbeBin)/OpenMetaverseTypes.dll</HintPath></Reference>
    <Reference Include="OpenMetaverse.StructuredData"><HintPath>$(ProbeBin)/OpenMetaverse.StructuredData.dll</HintPath></Reference>
    <Reference Include="log4net"><HintPath>$(MutSeaBin)/log4net.dll</HintPath></Reference>
    <Reference Include="XMLRPC"><HintPath>$(MutSeaBin)/XMLRPC.dll</HintPath></Reference>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
</Project>
