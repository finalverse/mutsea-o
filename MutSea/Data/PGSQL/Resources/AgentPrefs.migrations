:VERSION 1

BEGIN TRANSACTION;

CREATE TABLE IF NOT EXISTS "public"."agentprefs" (
	"PrincipalID" uuid NOT NULL,
	"AccessPrefs" char(2) NOT NULL DEFAULT 'M'::bpchar COLLATE "default",
	"HoverHeight" float8 NOT NULL DEFAULT 0,
	"Language" char(5) NOT NULL DEFAULT 'en-us'::bpchar COLLATE "default",
	"LanguageIsPublic" bool NOT NULL DEFAULT true,
	"PermEveryone" int4 NOT NULL DEFAULT 0,
	"PermGroup" int4 NOT NULL DEFAULT 0,
	"PermNextOwner" int4 NOT NULL DEFAULT 532480
)
WITH (OIDS=FALSE);

ALTER TABLE "public"."agentprefs" ADD PRIMARY KEY ("PrincipalID") NOT DEFERRABLE INITIALLY IMMEDIATE;

COMMIT;

:VERSION 2
BEGIN;
-- Fixed-width char values acquire padding, changing native string preferences.
ALTER TABLE agentprefs ALTER COLUMN "AccessPrefs" DROP DEFAULT;
ALTER TABLE agentprefs ALTER COLUMN "Language" DROP DEFAULT;
ALTER TABLE agentprefs ALTER COLUMN "AccessPrefs" TYPE varchar(2) USING rtrim("AccessPrefs");
ALTER TABLE agentprefs ALTER COLUMN "Language" TYPE varchar(5) USING rtrim("Language");
ALTER TABLE agentprefs ALTER COLUMN "AccessPrefs" SET DEFAULT 'M';
ALTER TABLE agentprefs ALTER COLUMN "Language" SET DEFAULT 'en-us';
COMMIT;
